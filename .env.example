# Vorlage: nach .env kopieren und Platzhalter ersetzen. .env niemals einchecken.
# Drei Datenbankrollen, jede mit eigenem Passwort:
# - Admin (Superuser des Containers): nur für npm run db:rollen
# - tagesbericht_migration: Eigentümerin der Tabellen, nur für Migrationen
# - tagesbericht_app: Anwendung, ohne Superuser- und ohne BYPASSRLS-Recht
# Die Rollennamen tagesbericht_migration und tagesbericht_app sind fest.
POSTGRES_USER=<admin>
POSTGRES_PASSWORD=<admin-passwort>
POSTGRES_DB=tagesbericht
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgres://<admin>:<admin-passwort>@db:5432/tagesbericht
DATABASE_MIGRATION_URL=postgres://tagesbericht_migration:<passwort-migration>@db:5432/tagesbericht
DATABASE_URL=postgres://tagesbericht_app:<passwort-app>@db:5432/tagesbericht
PORT=3000
